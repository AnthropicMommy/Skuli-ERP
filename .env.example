# Database (Neon Postgres — use pooled connection string with -pooler in host)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/skulix?sslmode=require"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Resend (email)
RESEND_API_KEY=re_xxxxx

# Groq (AI Teacher — Mwalimu)
GROQ_API_KEY=gsk_xxxxx

# JWT (student/parent auth)
JWT_SECRET=your-secret-key-here

# Vercel Blob (file storage for Materials)
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxx

# App
NEXT_PUBLIC_APP_URL=https://skuli.vercel.app
